# Base Public URL (for Meta Graph API to fetch uploaded media containers)
# When testing locally with Meta APIs, use ngrok or localtunnel: e.g. https://xxxx.ngrok-free.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Meta / Facebook & Instagram Developer App Credentials (Optional if using direct access tokens)
META_APP_ID=
META_APP_SECRET=

# X (Twitter) Developer API Credentials
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# Global Simulation Mode: set to "false" when you want all requests to hit real live APIs
SIMULATION_MODE=false

